  {
   "name": "delayed advisor reply",
   "kind": "consume",
   "settings": "{\"advisorModel\":\"opus\"}",
   "script": {
    "init": {
     "model": "claude-fable-5"
    },
    "on_init": [
     {
      "type": "system",
      "subtype": "probe_one"
     },
     {
      "type": "system",
      "subtype": "probe_two"
     }
    ],
    "control": {
     "apply_flag_settings": {
      "$response": {},
      "$delay_ms": 1500
     }
    }
   },
   "order": [
    "sdk:init",
    "sdk:probe_one",
    "sdk:probe_two",
    "advisor_disabled_on_model_change"
