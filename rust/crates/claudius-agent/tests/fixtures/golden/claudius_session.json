{
  "sdkVersion": "0.3.299",
  "case": "claudius_session",
  "spec": {
    "model": "claude-opus-4-8",
    "permissionMode": "default",
    "sessionId": "11111111-1111-4111-8111-111111111111",
    "systemPrompt": {
      "type": "preset",
      "preset": "claude_code",
      "append": "Claudius context."
    },
    "planModeInstructions": "Plan carefully.",
    "settingSources": [
      "user",
      "project",
      "local"
    ],
    "allowedTools": [
      "TodoWrite",
      "TaskCreate"
    ],
    "additionalDirectories": [
      "/golden/extra"
    ],
    "mcpServers": {
      "ext": {
        "type": "stdio",
        "command": "echo",
        "args": [
          "hi"
        ]
      },
      "alpha": {
        "type": "http",
        "url": "http://127.0.0.1:9/mcp"
      }
    },
    "$sdkMcpServers": {
      "claudius_goal": {
        "version": "1.0.0",
        "timeout": 10000,
        "tools": [
          {
            "name": "report_goal_achieved",
            "description": "Report that the user's stated session goal has been fully accomplished.",
            "params": {
              "summary": {
                "description": "One sentence summarizing what was accomplished."
              }
            }
          }
        ]
      },
      "aux_tools": {
        "version": "0.1.0"
      }
    },
    "$canUseTool": true,
    "$onElicitation": true,
    "$hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "count": 2
        },
        {
          "timeout": 30
        }
      ],
      "PostToolUse": [
        {}
      ],
      "CwdChanged": [
        {}
      ],
      "PostModelSwitch": [
        {}
      ]
    },
    "includePartialMessages": true,
    "includeHookEvents": true,
    "perTaskStopAffordance": true,
    "forwardSubagentText": true,
    "agentProgressSummaries": true,
    "promptSuggestions": true,
    "enableFileCheckpointing": true,
    "thinking": {
      "type": "adaptive"
    },
    "toolConfig": {
      "askUserQuestion": {
        "previewFormat": "html"
      }
    },
    "settings": {
      "includeCoAuthoredBy": false
    }
  },
  "baseEnv": {
    "PATH": "/usr/bin:/bin",
    "HOME": "/golden/home",
    "LANG": "en_US.UTF-8",
    "NODE_OPTIONS": "--max-old-space-size=64",
    "DEBUG": "1",
    "CLAUDE_CODE_AGENT_PROGRESS_SUMMARIES": "1",
    "CLAUDE_CODE_QUESTION_EXTENDED": "1"
  },
  "argv": [
    "--output-format",
    "stream-json",
    "--verbose",
    "--input-format",
    "stream-json",
    "--thinking=adaptive",
    "--model=claude-opus-4-8",
    "--permission-prompt-tool=stdio",
    "--allowedTools=TodoWrite,TaskCreate",
    "--mcp-config",
    "{\"mcpServers\":{\"ext\":{\"type\":\"stdio\",\"command\":\"echo\",\"args\":[\"hi\"]},\"alpha\":{\"type\":\"http\",\"url\":\"http://127.0.0.1:9/mcp\"}}}",
    "--setting-sources=user,project,local",
    "--permission-mode=default",
    "--include-hook-events",
    "--include-partial-messages",
    "--add-dir=/golden/extra",
    "--session-id=11111111-1111-4111-8111-111111111111",
    "--settings",
    "{\"includeCoAuthoredBy\":false}"
  ],
  "env": {
    "CLAUDE_AGENT_SDK_VERSION": "0.3.299",
    "CLAUDE_CODE_AGENT_PROGRESS_SUMMARIES": "1",
    "CLAUDE_CODE_ENABLE_SDK_FILE_CHECKPOINTING": "true",
    "CLAUDE_CODE_ENTRYPOINT": "sdk-ts",
    "CLAUDE_CODE_QUESTION_EXTENDED": "1",
    "CLAUDE_CODE_QUESTION_PREVIEW_FORMAT": "html",
    "CLAUDE_CODE_SDK_READS_SESSION_STATE": "1",
    "HOME": "/golden/home",
    "LANG": "en_US.UTF-8",
    "PATH": "/usr/bin:/bin"
  },
  "initialize": {
    "subtype": "initialize",
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hookCallbackIds": [
            "hook_0",
            "hook_1"
          ]
        },
        {
          "hookCallbackIds": [
            "hook_2"
          ],
          "timeout": 30
        }
      ],
      "PostToolUse": [
        {
          "hookCallbackIds": [
            "hook_3"
          ]
        }
      ],
      "CwdChanged": [
        {
          "hookCallbackIds": [
            "hook_4"
          ]
        }
      ],
      "PostModelSwitch": [
        {
          "hookCallbackIds": [
            "hook_5"
          ]
        }
      ]
    },
    "sdkMcpServers": [
      "claudius_goal",
      "aux_tools"
    ],
    "sdkMcpServerConfigs": {
      "claudius_goal": {
        "timeout": 10000
      }
    },
    "sdkMcpServerManifests": {
      "claudius_goal": {
        "initializeResult": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "tools": {
              "listChanged": true
            }
          },
          "serverInfo": {
            "name": "claudius_goal",
            "version": "1.0.0"
          }
        },
        "toolsListResult": {
          "tools": [
            {
              "name": "report_goal_achieved",
              "description": "Report that the user's stated session goal has been fully accomplished.",
              "inputSchema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "type": "object",
                "properties": {
                  "summary": {
                    "type": "string",
                    "description": "One sentence summarizing what was accomplished."
                  }
                },
                "required": [
                  "summary"
                ]
              },
              "execution": {
                "taskSupport": "forbidden"
              }
            }
          ]
        }
      }
    },
    "appendSystemPrompt": "Claudius context.",
    "planModeInstructions": "Plan carefully.",
    "promptSuggestions": true,
    "agentProgressSummaries": true,
    "forwardSubagentText": true,
    "perTaskStopAffordance": true
  },
  "stdin": [
    {
      "request_id": "$ID0",
      "type": "control_request",
      "request": {
        "subtype": "initialize",
        "hooks": {
          "PreToolUse": [
            {
              "matcher": "Bash",
              "hookCallbackIds": [
                "hook_0",
                "hook_1"
              ]
            },
            {
              "hookCallbackIds": [
                "hook_2"
              ],
              "timeout": 30
            }
          ],
          "PostToolUse": [
            {
              "hookCallbackIds": [
                "hook_3"
              ]
            }
          ],
          "CwdChanged": [
            {
              "hookCallbackIds": [
                "hook_4"
              ]
            }
          ],
          "PostModelSwitch": [
            {
              "hookCallbackIds": [
                "hook_5"
              ]
            }
          ]
        },
        "sdkMcpServers": [
          "claudius_goal",
          "aux_tools"
        ],
        "sdkMcpServerConfigs": {
          "claudius_goal": {
            "timeout": 10000
          }
        },
        "sdkMcpServerManifests": {
          "claudius_goal": {
            "initializeResult": {
              "protocolVersion": "2025-11-25",
              "capabilities": {
                "tools": {
                  "listChanged": true
                }
              },
              "serverInfo": {
                "name": "claudius_goal",
                "version": "1.0.0"
              }
            },
            "toolsListResult": {
              "tools": [
                {
                  "name": "report_goal_achieved",
                  "description": "Report that the user's stated session goal has been fully accomplished.",
                  "inputSchema": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "type": "object",
                    "properties": {
                      "summary": {
                        "type": "string",
                        "description": "One sentence summarizing what was accomplished."
                      }
                    },
                    "required": [
                      "summary"
                    ]
                  },
                  "execution": {
                    "taskSupport": "forbidden"
                  }
                }
              ]
            }
          }
        },
        "appendSystemPrompt": "Claudius context.",
        "planModeInstructions": "Plan carefully.",
        "promptSuggestions": true,
        "agentProgressSummaries": true,
        "forwardSubagentText": true,
        "perTaskStopAffordance": true
      }
    },
    {
      "type": "user",
      "message": {
        "role": "user",
        "content": "hello"
      },
      "parent_tool_use_id": null,
      "session_id": ""
    }
  ]
}
